# Security Environment Variables
NODE_ENV=development
# Set to 'production' in production environment
# NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=replace_this_with_a_strong_random_string_in_production
JWT_EXPIRES_IN=1d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSL/TLS Configuration
SSL_CERT_PATH=./config/ssl/server.crt
SSL_KEY_PATH=./config/ssl/server.key

# Cookie Security
COOKIE_SECRET=replace_this_with_another_strong_random_string
COOKIE_SECURE=false
# Set to 'true' in production
# COOKIE_SECURE=true

# Database Security (if applicable)
DB_ENCRYPTION_KEY=replace_with_strong_encryption_key
